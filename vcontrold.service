[Unit]
Description=Vcontrold Service
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
ExecStart=/usr/sbin/vcontrold -x /home/s53zo/ViesmannK8/vcontrold.xml -d /dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
Restart=always
RestartSec=5

[Install]
