{
  "uid": "vito-2048-telemetry-v2",
  "title": "Viessmann · Heat pump telemetry",
  "description": "Acquisition-time telemetry from the Vitocal 2048 reader.",
  "editable": true,
  "timezone": "browser",
  "tags": [
    "Viessmann",
    "Optolink"
  ],
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "register",
        "datasource": {
          "type": "influxdb",
          "uid": "deasq3bzjrx8ge"
        },
        "query": "SHOW TAG VALUES FROM \"vito_observation_v2\" WITH KEY = \"register\" WHERE \"device\" = 'vitocal-2048'",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "type": "custom",
        "name": "confidence",
        "query": "verified,provisional,unknown",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "verified",
            "value": "verified",
            "selected": false
          },
          {
            "text": "provisional",
            "value": "provisional",
            "selected": false
          },
          {
            "text": "unknown",
            "value": "unknown",
            "selected": false
          }
        ]
      },
      {
        "type": "custom",
        "name": "quality",
        "query": "ok,provisional,unmapped,sentinel,timeout,read_error,partial",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "ok",
            "value": "ok",
            "selected": false
          },
          {
            "text": "provisional",
            "value": "provisional",
            "selected": false
          },
          {
            "text": "unmapped",
            "value": "unmapped",
            "selected": false
          },
          {
            "text": "sentinel",
            "value": "sentinel",
            "selected": false
          },
          {
            "text": "timeout",
            "value": "timeout",
            "selected": false
          },
          {
            "text": "read_error",
            "value": "read_error",
            "selected": false
          },
          {
            "text": "partial",
            "value": "partial",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Compressor cycling",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "id": 2,
      "title": "Controller totals",
      "type": "timeseries",
      "description": "Cumulative starts and hours reported by the controller. The runtime register stores seconds. A fall in either total indicates a reset.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "deasq3bzjrx8ge"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "deasq3bzjrx8ge"
          },
          "refId": "A",
          "alias": "Starts",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT last(\"counter_value\") FROM \"vito_observation_v2\" WHERE \"device\" = 'vitocal-2048' AND $timeFilter AND \"register\" = '0500-4' GROUP BY time($__interval) fill(null)"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "deasq3bzjrx8ge"
          },
          "refId": "B",
          "alias": "Runtime",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT last(\"counter_value\") / 3600 FROM \"vito_observation_v2\" WHERE \"device\" = 'vitocal-2048' AND $timeFilter AND \"register\" = '0580-4' GROUP BY time($__interval) fill(null)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Runtime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "h"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "transformations": []
    },
    {
      "id": 3,
      "title": "Starts by hour and day",
      "type": "timeseries",
      "description": "Each increase is assigned to the bucket containing its later observation. The first observation in the selected window is the baseline. A counter drop is excluded. UTC day boundaries; edge buckets may be partial.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "deasq3bzjrx8ge"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "deasq3bzjrx8ge"
          },
          "refId": "A",
          "alias": "Starts / 1h",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"increase\") FROM (SELECT non_negative_difference(\"counter_value\") AS \"increase\" FROM \"vito_observation_v2\" WHERE \"device\" = 'vitocal-2048' AND $timeFilter AND \"register\" = '0500-4') GROUP BY time(1h) fill(none)"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "deasq3bzjrx8ge"
          },
          "refId": "B",
          "alias": "Starts / 1d",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"increase\") FROM (SELECT non_negative_difference(\"counter_value\") AS \"increase\" FROM \"vito_observation_v2\" WHERE \"device\" = 'vitocal-2048' AND $timeFilter AND \"register\" = '0500-4') GROUP BY time(1d) fill(none)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "custom": {
            "drawStyle": "bars"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "transformations": []
    },
    {
      "id": 4,
      "title": "Whole-house power and observed starts",
      "type": "timeseries",
      "description": "Power includes all household loads. A positive point counts starts since the prior successful poll. A negative point indicates a reset. The time marks the read, not the physical start.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "fe9liwluvfev4d"
          },
          "refId": "A",
          "alias": "Whole house",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"value\") FROM \"house\" WHERE $timeFilter GROUP BY time($__interval) fill(null)"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "deasq3bzjrx8ge"
          },
          "refId": "B",
          "alias": "Counter change",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT difference(\"counter_value\") AS \"increase\" FROM \"vito_observation_v2\" WHERE \"device\" = 'vitocal-2048' AND $timeFilter AND \"register\" = '0500-4'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Counter change"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "Starts"
              },
              {
                "id": "custom.showPoints",
                "value": "always"
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.pointSize",
                "value": 5
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "transformations": []
    },
    {
      "id": 5,
      "title": "Minutes per start · selected window",
      "type": "stat",
      "description": "Change in runtime seconds divided by 60 and by starts. Uses first and last valid samples inside the range. Requires a start, no counter decrease, readings within 90 seconds of both edges, and gaps at most 90 seconds. Runs spanning a boundary contribute partial runtime.",
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "deasq3bzjrx8ge"
          },
          "refId": "Q1",
          "alias": "sample",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT last(\"counter_value\") - first(\"counter_value\") FROM \"vito_observation_v2\" WHERE \"device\" = 'vitocal-2048' AND $timeFilter AND \"register\" = '0500-4' AND \"counter_value\" >= 0"
        },
        {
          "refId": "R1",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "Q1",
          "reducer": "last"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "deasq3bzjrx8ge"
          },
          "refId": "Q2",
          "alias": "sample",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT min(v) FROM (SELECT difference(\"counter_value\") AS v FROM \"vito_observation_v2\" WHERE \"device\" = 'vitocal-2048' AND $timeFilter AND \"register\" = '0500-4' AND \"counter_value\" >= 0)"
        },
        {
          "refId": "R2",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "Q2",
          "reducer": "last"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "deasq3bzjrx8ge"
          },
          "refId": "Q3",
          "alias": "sample",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT max(v) FROM (SELECT elapsed(\"counter_value\", 1s) AS v FROM \"vito_observation_v2\" WHERE \"device\" = 'vitocal-2048' AND $timeFilter AND \"register\" = '0500-4' AND \"counter_value\" >= 0)"
        },
        {
          "refId": "R3",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "Q3",
          "reducer": "last"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "deasq3bzjrx8ge"
          },
          "refId": "Q4",
          "alias": "sample",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT count(\"counter_value\") FROM \"vito_observation_v2\" WHERE \"device\" = 'vitocal-2048' AND $timeFilter AND \"register\" = '0500-4' AND \"counter_value\" >= 0 AND time <= ${__from}ms + 90s"
        },
        {
          "refId": "R4",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "Q4",
          "reducer": "last"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "deasq3bzjrx8ge"
          },
          "refId": "Q5",
          "alias": "sample",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT count(\"counter_value\") FROM \"vito_observation_v2\" WHERE \"device\" = 'vitocal-2048' AND $timeFilter AND \"register\" = '0500-4' AND \"counter_value\" >= 0 AND time >= ${__to}ms - 90s"
        },
        {
          "refId": "R5",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "Q5",
          "reducer": "last"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "deasq3bzjrx8ge"
          },
          "refId": "Q6",
          "alias": "sample",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT last(\"counter_value\") - first(\"counter_value\") FROM \"vito_observation_v2\" WHERE \"device\" = 'vitocal-2048' AND $timeFilter AND \"register\" = '0580-4' AND \"counter_value\" >= 0"
        },
        {
          "refId": "R6",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "Q6",
          "reducer": "last"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "deasq3bzjrx8ge"
          },
          "refId": "Q7",
          "alias": "sample",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT min(v) FROM (SELECT difference(\"counter_value\") AS v FROM \"vito_observation_v2\" WHERE \"device\" = 'vitocal-2048' AND $timeFilter AND \"register\" = '0580-4' AND \"counter_value\" >= 0)"
        },
        {
          "refId": "R7",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "Q7",
          "reducer": "last"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "deasq3bzjrx8ge"
          },
          "refId": "Q8",
          "alias": "sample",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT max(v) FROM (SELECT elapsed(\"counter_value\", 1s) AS v FROM \"vito_observation_v2\" WHERE \"device\" = 'vitocal-2048' AND $timeFilter AND \"register\" = '0580-4' AND \"counter_value\" >= 0)"
        },
        {
          "refId": "R8",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "Q8",
          "reducer": "last"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "deasq3bzjrx8ge"
          },
          "refId": "Q9",
          "alias": "sample",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT count(\"counter_value\") FROM \"vito_observation_v2\" WHERE \"device\" = 'vitocal-2048' AND $timeFilter AND \"register\" = '0580-4' AND \"counter_value\" >= 0 AND time <= ${__from}ms + 90s"
        },
        {
          "refId": "R9",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "Q9",
          "reducer": "last"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "deasq3bzjrx8ge"
          },
          "refId": "Q10",
          "alias": "sample",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT count(\"counter_value\") FROM \"vito_observation_v2\" WHERE \"device\" = 'vitocal-2048' AND $timeFilter AND \"register\" = '0580-4' AND \"counter_value\" >= 0 AND time >= ${__to}ms - 90s"
        },
        {
          "refId": "R10",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "reduce",
          "expression": "Q10",
          "reducer": "last"
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "math",
          "expression": "($R1 > 0) && ($R2 >= 0) && ($R3 <= 90) && ($R4 > 0) && ($R5 > 0) && ($R7 >= 0) && ($R8 <= 90) && ($R9 > 0) && ($R10 > 0)",
          "refId": "Valid"
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "math",
          "expression": "($R6 / 60) / $R1 * ($Valid / $Valid)",
          "refId": "Result"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "noValue": "Insufficient coverage",
          "unit": "m"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "none",
        "textMode": "value",
        "graphMode": "none"
      },
      "transformations": [
        {
          "id": "filterByRefId",
          "options": {
            "include": "Result"
          }
        }
      ]
    },
