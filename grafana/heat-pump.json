    {
      "id": 8,
      "title": "Auxiliary heater totals",
      "type": "timeseries",
      "description": "Starts and accumulated operating time for the two heater stages. Both stages can operate together. Hours are calculated from raw seconds.",
      "gridPos": {
        "x": 15,
        "y": 18,
        "w": 9,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "deasq3bzjrx8ge"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "deasq3bzjrx8ge"
          },
          "refId": "A",
          "alias": "Stage 1 starts",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT last(\"counter_value\") FROM \"vito_observation_v2\" WHERE \"device\" = 'vitocal-2048' AND $timeFilter AND \"register\" = '0508-4' GROUP BY time($__interval) fill(null)"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "deasq3bzjrx8ge"
          },
          "refId": "B",
          "alias": "Stage 2 starts",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT last(\"counter_value\") FROM \"vito_observation_v2\" WHERE \"device\" = 'vitocal-2048' AND $timeFilter AND \"register\" = '0509-4' GROUP BY time($__interval) fill(null)"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "deasq3bzjrx8ge"
          },
          "refId": "C",
          "alias": "Stage 1 runtime",
